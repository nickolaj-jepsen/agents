{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "nickolaj-jepsen",
  "owner": {
    "name": "Nickolaj Jepsen"
  },
  "metadata": {
    "description": "Agent skills and Claude Code mods from nickolaj-jepsen/agents"
  },
  "plugins": [
    {
      "name": "skills",
      "description": "Agent skills from nickolaj-jepsen/agents",
      "source": "./",
      "strict": false
    },
    {
      "name": "spellfix",
      "source": {
        "source": "git-subdir",
        "url": "nickolaj-jepsen/agents",
        "path": "spellfix",
        "ref": "dist"
      }
    },
    {
      "name": "linear-issue",
      "source": {
        "source": "git-subdir",
        "url": "nickolaj-jepsen/agents",
        "path": "linear-issue",
        "ref": "dist"
      }
    },
    {
      "name": "git-menu",
      "source": {
        "source": "git-subdir",
        "url": "nickolaj-jepsen/agents",
        "path": "git-menu",
        "ref": "dist"
      }
    },
    {
      "name": "answer",
      "source": {
        "source": "git-subdir",
        "url": "nickolaj-jepsen/agents",
        "path": "answer",
        "ref": "dist"
      }
    },
    {
      "name": "docfix",
      "source": {
        "source": "git-subdir",
        "url": "nickolaj-jepsen/agents",
        "path": "docfix",
        "ref": "dist"
      }
    },
    {
      "name": "image-preview",
      "source": {
        "source": "git-subdir",
        "url": "nickolaj-jepsen/agents",
        "path": "image-preview",
        "ref": "dist"
      }
    }
  ]
}
