{
  "extends": ["//"],
  "tasks": {
    "build": {
      "command": ["node", "../../lib/tools/build/build.ts"]
    },
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"]
    },
    "check-types": {
      "command": ["./node_modules/.bin/tsc", "-b", "tsconfig.json"]
    },
    "e2e": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "test", "chrome"]
    },
    "e2e:update": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "test", "chrome", "--update"]
    }
  }
}
