{
  "extends": ["//"],
  "tasks": {
    "build": {
      "command": ["node", "../../lib/tools/build/build.ts"]
    },
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"]
    },
    "test:claude": {
      "command": ["sh", "../../lib/tools/build/claude-plugin-test.sh"]
    },
    "e2e": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "test", "image-preview"]
    },
    "e2e:update": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "test", "image-preview", "--update"]
    },
    "types": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "types", "image-preview"]
    },
    "check-types": {
      "command": ["./node_modules/.bin/tsc", "-b", "tsconfig.json", "tsconfig.claude.json"]
    },
    "media": {
      "command": [
        "nix",
        "run",
        "../..#media",
        "--",
        "node",
        "../../lib/tools/drive/drive.ts",
        "record",
        "image-preview",
        "--harness",
        "terminal"
      ],
      "outputs": ["$TURBO_ROOT$/apps/site/media/image-preview/**"]
    }
  }
}
