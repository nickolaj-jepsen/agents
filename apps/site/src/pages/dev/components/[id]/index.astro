---
import type { GetStaticPaths } from 'astro';
import Shell from '../../../../components/catalog/Shell.astro';
import Mark from '../../../../components/catalog/Mark.astro';
import Status from '../../../../components/catalog/Status.astro';
import Renders from '../../../../components/catalog/Renders.astro';
import Features from '../../../../components/catalog/Features.astro';
import Toolbar from '../../../../components/catalog/Toolbar.astro';
import Api from '../../../../components/catalog/Api.astro';
import {
  catalogHref,
  differs,
  getComponents,
  HARNESSES,
  implMark,
  sizesOf,
  storyAnchor,
  TITLES,
  type Component,
} from '../../../../lib/catalog.ts';

export const getStaticPaths = (async () =>
  (await getComponents()).map((c) => ({ params: { id: c.id }, props: { c } }))) satisfies GetStaticPaths;

interface Props {
  c: Component;
}
const { c } = Astro.props;
const sizes = sizesOf(c.stories);
const size = sizes[0];
const nd = c.features.filter(differs).length;
// A feature no story shows has no story to sit under: it closes the list.
const unshown = c.features.filter((f) => !c.stories.some((s) => HARNESSES.some((h) => f.story[h] === s.id)));
---

<Shell title={`${c.name} · Components`} description={c.purpose} current={c} crumbs={[{ name: 'UI kit', href: catalogHref() }, { name: c.name }]}>
  <header class="lede">
    <h1>{c.name}</h1>
    <p class="lead">{c.purpose}</p>
    <ul class="summary">
      {
        HARNESSES.map((h) => (
          <li>
            <Mark h={h} state={implMark(c, h)} /> {TITLES[h]} <Status status={c.impl[h].state} />{' '}
            {c.impl[h].state === 'none' ? (
              <span class="sub">{c.impl[h].reason}</span>
            ) : (
              <span>
                {c.impl[h].exports.map((e, i) => (
                  <>
                    {i > 0 && ', '}
                    <code>{e}</code>
                  </>
                ))}
              </span>
            )}
          </li>
        ))
      }
      <li>
        {c.stories.length} {c.stories.length === 1 ? 'story' : 'stories'}, {c.features.length} {c.features.length === 1 ? 'feature' : 'features'}
        {nd > 0 && <> ({nd} differ between the harnesses)</>}
      </li>
      <li><a href="#props">Props ↓</a></li>
    </ul>
  </header>

  <Toolbar sizes={sizes} />

  <section id="stories" class="cat-section" aria-labelledby="stories-h">
    <div class="section-head">
      <h2 id="stories-h">Stories</h2>
      <span class="count">{c.stories.length}</span>
    </div>
    {
      c.stories.length === 0 ? (
        <p class="sub">No stories yet.</p>
      ) : (
        <ul class="story-rows">
          {c.stories.map((s) => {
            const about = HARNESSES.map((h) => s.by[h]?.about).find(Boolean);
            return (
              <li id={storyAnchor(s)} class="story-stage">
                <div class="rhead">
                  <a class="title" href={`#${storyAnchor(s)}`}>
                    {s.state}
                  </a>
                  {about && <span class="about">{about}</span>}
                </div>
                <Renders c={c} s={s} size={size} />
                <Features features={c.features.filter((f) => HARNESSES.some((h) => f.story[h] === s.id))} about={about} />
              </li>
            );
          })}
        </ul>
      )
    }
    {
      unshown.length > 0 && (
        <div class="unshown">
          <h3 class="side-h sc">Features no story shows</h3>
          <Features features={unshown} />
        </div>
      )
    }
  </section>

  <section id="props" class="cat-section" aria-labelledby="props-h">
    <div class="section-head">
      <h2 id="props-h">Props</h2>
      <span class="aside">Read from the kits' source and doc comments</span>
    </div>
    <div class="api-cols">
      {HARNESSES.map((h) => <Api c={c} h={h} />)}
    </div>
  </section>
</Shell>
