---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Install from '../../components/Install.astro';
import Notice from '../../components/Notice.astro';
import Pager from '../../components/Pager.astro';
import Wip from '../../components/Wip.astro';
import { content, github, href, skillHref, skillInstall, type Skill } from '../../lib/content.ts';
import { renderInline, renderMarkdown } from '../../lib/markdown.ts';
import { headings, linkReferences, requirements, whenToUse } from '../../lib/skill.ts';
import '../../styles/skill.css';

export const getStaticPaths = (() => {
  const c = content();
  // The order of the home page: by category, in-progress last in each.
  const order = c.categories.flatMap((cat) => cat.skills.map((skill) => ({ skill, cat })));
  return order.map(({ skill, cat }, i) => ({
    params: { name: skill.name },
    props: { skill, category: cat, prev: order[i - 1]?.skill, next: order[i + 1]?.skill },
  }));
}) satisfies GetStaticPaths;

interface Props {
  skill: Skill;
  category: { slug: string; title: string };
  prev?: Skill;
  next?: Skill;
}
const { skill: s, category, prev, next } = Astro.props;
const file = `${s.path}/SKILL.md`;
const summary = s.summary.charAt(0).toUpperCase() + s.summary.slice(1);
const lead = await renderInline(summary, file);
const credit = s.credit && (await renderInline(s.credit, file));
const description = await renderInline(s.description, file);
// The page's own title stands for the body's first heading when that only names the skill.
const rendered = await renderMarkdown(s.body.replace(new RegExp(`^# ${s.name}\\s*\\n+`), ''), file);
const toc = headings(rendered);
const body = linkReferences(rendered, toc);
const lines = s.lines;
const when = await renderInline(whenToUse(s.description), file);
const needs = await Promise.all(requirements(s.body).map((r) => renderInline(r, file)));
const usage = `/${s.name}${s.argumentHint ? ` ${s.argumentHint}` : ''}`;
const inst = skillInstall(s);
---

<Base title={s.name} description={summary.replace(/`/g, '')} nav="skills">
  <header class="lede wide">
    <p class="crumb">
      <a href={href('#skills')}>Skills</a> / <a href={href(`#${category.slug}`)}>{category.title}</a>
    </p>
    <div class="title-row">
      <h1 class="mono">{s.name}</h1>
      {s.status === 'in-progress' && <Wip />}
    </div>
    <p class="lead" set:html={lead} />
    <div class="head-meta">
      <Install what={s.name} commands={inst.commands} more={inst.more} />
    </div>
    {s.status === 'in-progress' && <Notice />}
  </header>

  <dl class="facts glance">
    <dt>Invoke</dt>
    <dd><code>{usage}</code></dd>
    <dt>Used when</dt>
    <dd set:html={when} />
    {
      needs.length > 0 && (
        <>
          <dt>Needs</dt>
          <dd>
            <ul class="plain">
              {needs.map((n) => (
                <li set:html={n} />
              ))}
            </ul>
          </dd>
        </>
      )
    }
  </dl>

  <div class="spread">
    <section class="agent-reads" aria-labelledby="reads-h">
      <h2 id="reads-h">What the agent reads</h2>
      <p class="sub">The skill as the agent loads it: the description decides when, the rest is the instructions.</p>
      <div class="file">
        <div class="file-head">
          <code>{file}</code>
          <a href={github(file, false)}>source ↗</a>
        </div>
        <div class="file-desc">
          <span class="sc">description</span>
          <p set:html={description} />
        </div>
        <div class="file-clip" id="skill-body">
          <div class="prose file-body" set:html={body} />
        </div>
        <button type="button" class="file-toggle" hidden aria-expanded="false" aria-controls="skill-body" data-lines={lines}>
          Read all of SKILL.md ({lines} lines)
        </button>
        <script is:inline>
          (() => {
            const f = document.currentScript.parentElement;
            f.classList.add('js', 'collapsed');
            f.querySelector('.file-toggle').hidden = false;
          })();
        </script>
      </div>
    </section>

    <aside class="rail side" aria-label="About this skill">
    <dl class="facts">
      {
        credit && (
          <>
            <dt>Credit</dt>
            <dd set:html={credit} />
          </>
        )
      }
      <dt>Files</dt>
      <dd>
        <ul class="plain files">
          {
            ['SKILL.md', ...s.files].map((f) => (
              <li>
                <a href={github(`${s.path}/${f}`, false)}>
                  <code>{f}</code>
                </a>
              </li>
            ))
          }
        </ul>
      </dd>
      <dt>Source</dt>
      <dd><a href={github(`${s.path}/`)}><code>{s.path}/</code></a> on GitHub</dd>
    </dl>
    {
      toc.length > 0 && (
        <nav class="toc" aria-label="Contents of SKILL.md">
          <p class="sc">Contents</p>
          <ul class="plain">
            {toc.map((h) => (
              <li class={h.level === 3 ? 'sub' : undefined}>
                <a href={`#${h.id}`} set:html={h.html} />
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    </aside>
  </div>

  <Pager
    label="Skills"
    prev={prev && { href: skillHref(prev.name), name: prev.name }}
    next={next && { href: skillHref(next.name), name: next.name }}
  />
</Base>

<script>
  import '../../client/skill.ts';
</script>
