---
import Base from '../layouts/Base.astro';
import HarnessSwitch from '../components/HarnessSwitch.astro';
import Install from '../components/Install.astro';
import Marks from '../components/Marks.astro';
import Wip from '../components/Wip.astro';
import {
  CLAUDE_NOTE,
  content,
  harnesses,
  pluginHref,
  pluginInstall,
  bundleHref,
  bundleInstall,
  skillHref,
  skillInstall,
} from '../lib/content.ts';
import { looksOf } from '../lib/posters.ts';
import '../styles/home.css';
import { renderInline } from '../lib/markdown.ts';

const c = await content();
const intro = await renderInline(c.intro, 'docs/_intro.md');
const inline = (md: string, file = 'README.md') => renderInline(md, file);
const taglines = new Map(await Promise.all(c.plugins.map(async (p) => [p.name, await inline(p.tagline)] as const)));
const summaries = new Map(await Promise.all(c.skills.map(async (s) => [s.name, await inline(s.summary)] as const)));
const bundleLines = new Map(await Promise.all(c.bundles.map(async (b) => [b.name, await inline(b.tagline, `${b.path}/README.md`)] as const)));
---

<Base description="Plugins for Claude Code and the pi coding agent, and agent skills for any agent that reads them.">
  <section class="intro" aria-label="About">
    <p class="lead" set:html={intro} />
  </section>

  <section class="section" id="plugins" aria-labelledby="plugins-h">
    <div class="section-head">
      <h2 id="plugins-h">Plugins</h2>
      <span class="count" data-count>{c.plugins.length}</span>
      <div class="aside">
        <HarnessSwitch both />
      </div>
    </div>
    <ul class="tiles" data-tiles>
      {
        c.plugins.map((p, i) => {
          const looks = looksOf(p);
          return (
            <li class="tile" aria-labelledby={`p-${p.name}`} data-harnesses={harnesses(p).join(' ')}>
              <a class="tile-pic" href={pluginHref(p.name)} tabindex="-1" aria-hidden="true">
                {looks.length > 0 ? (
                  looks.map((look, n) => {
                    const r = look.rect;
                    return (
                      <span
                        class:list={['crop', { whole: !r }]}
                        data-h={look.h}
                        style={r ? `--w:${r.w};--h:${r.h};--iw:${look.width};--x:${r.x};--y:${r.y}` : undefined}
                      >
                        <img
                          src={look.src}
                          width={look.width}
                          height={look.height}
                          alt=""
                          loading={i < 2 && n === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      </span>
                    );
                  })
                ) : (
                  <span class="no-pic">{p.name}</span>
                )}
              </a>
              <div class="tile-head">
                <h3 id={`p-${p.name}`}>
                  <a href={pluginHref(p.name)}>{p.name}</a>
                </h3>
                {p.tier === 'unfinished' && <Wip />}
                <Marks harnesses={harnesses(p)} short />
                <span class="grow" />
                {pluginInstall(p).length > 0 && (
                  <Install what={p.name} commands={pluginInstall(p)} note={p.install.claude ? CLAUDE_NOTE(p.version) : undefined} align="end" />
                )}
              </div>
              <p class="tagline" set:html={taglines.get(p.name)} />
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-h">
    <div class="section-head">
      <h2 id="skills-h">Skills</h2>
      <span class="count">{c.skills.length}</span>
      <span class="aside">For any agent that reads skills</span>
    </div>
    {
      c.bundles.length > 0 && (
        <section class="group" id="bundles" aria-labelledby="c-bundles">
          <div class="group-head">
            <h3 class="sc" id="c-bundles">
              Bundles
            </h3>
            <p class="blurb">Sets of skills that work together, installed in one go.</p>
          </div>
          <ul class="srows">
            {c.bundles.map((b) => (
              <li>
                <a class="name" href={bundleHref(b.name)}>
                  {b.name}
                </a>
                <span class="what" set:html={bundleLines.get(b.name)} />
                <span class="end">
                  <Install what={b.name} commands={bundleInstall(b)} align="end" />
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      c.categories.map((cat) => (
        <section class="group" id={cat.slug} aria-labelledby={`c-${cat.slug}`}>
          <div class="group-head">
            <h3 class="sc" id={`c-${cat.slug}`}>
              {cat.title}
            </h3>
            {cat.blurb && <p class="blurb">{cat.blurb}</p>}
          </div>
          <ul class="srows">
            {cat.skills.map((s) => {
              const inst = skillInstall(s);
              return (
                <li class:list={{ wip: s.tier === 'unfinished' }}>
                  <a class="name" href={skillHref(s.name)}>
                    {s.name}
                  </a>
                  <span class="what" set:html={summaries.get(s.name)} />
                  <span class="end">
                    {s.tier === 'unfinished' && <Wip />}
                    <Install what={s.name} commands={inst.commands} more={inst.more} align="end" />
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </section>
  <script>
    import '../client/home.ts';
  </script>
</Base>
