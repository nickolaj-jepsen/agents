---
import type { GetStaticPaths } from 'astro';
import '../../styles/plugin.css';
import Base from '../../layouts/Base.astro';
import Command from '../../components/Command.astro';
import Gallery from '../../components/Gallery.astro';
import Install from '../../components/Install.astro';
import Marks from '../../components/Marks.astro';
import Notice from '../../components/Notice.astro';
import Pager from '../../components/Pager.astro';
import Wip from '../../components/Wip.astro';
import {
  bodyAfterTagline,
  CLAUDE_NOTE,
  content,
  github,
  harnesses,
  href,
  pluginHref,
  pluginInstall,
  type Plugin,
} from '../../lib/content.ts';
import { renderInline, renderMarkdown } from '../../lib/markdown.ts';

export const getStaticPaths = (async () =>
  (await content()).plugins.map((plugin, i, all) => ({
    params: { name: plugin.name },
    props: { plugin, prev: all[i - 1], next: all[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  plugin: Plugin;
  prev?: Plugin;
  next?: Plugin;
}
const { plugin: p, prev, next } = Astro.props;
const file = `${p.path}/README.md`;
const tagline = await renderInline(p.tagline, file);
const requires = await Promise.all(p.requires.map((r) => renderInline(r, file)));
const body = await renderMarkdown(bodyAfterTagline(p), file);
const install = pluginInstall(p);
---

<Base title={p.name} description={p.tagline.replace(/`/g, '')} nav="plugins">
  <header class="lede wide">
    <p class="crumb"><a href={href('#plugins')}>Plugins</a></p>
    <div class="title-row">
      <h1 class="mono">{p.name}</h1>
      {p.status === 'in-progress' && <Wip />}
    </div>
    <p class="lead" set:html={tagline} />
    <div class="head-meta">
      <Marks harnesses={harnesses(p)} />
      {install.length > 0 && <Install what={p.name} commands={install} note={p.install.claude ? CLAUDE_NOTE : undefined} />}
    </div>
    {p.status === 'in-progress' && <Notice />}
  </header>

  <Gallery plugin={p} />

  <div class="spread">
    <div class="prose body" set:html={body} />
    <dl class="facts rail">
      {
        requires.length > 0 && (
          <>
            <dt>Needs</dt>
            <dd>
              <ul class="plain">
                {requires.map((r) => (
                  <li set:html={r} />
                ))}
              </ul>
            </dd>
          </>
        )
      }
      <dt>Runs in</dt>
      <dd><Marks harnesses={harnesses(p)} /></dd>
      {
        install.length > 0 && (
          <>
            <dt>Install</dt>
            <dd>
              {install.map((c) => (
                <div class="inst-cmd">
                  {install.length > 1 && <span class="cmd-label">{c.label}</span>}
                  <Command command={c.command} what={`${p.name} for ${c.label}`} />
                </div>
              ))}
              {p.install.claude && <p class="inst-note" set:html={CLAUDE_NOTE} />}
            </dd>
          </>
        )
      }
      <dt>Source</dt>
      <dd><a href={github(`${p.path}/`)}><code>{p.path}/</code></a> on GitHub</dd>
    </dl>
  </div>

  <Pager
    label="Plugins"
    all={{ href: href('#plugins'), name: 'All plugins' }}
    prev={prev && { href: pluginHref(prev.name), name: prev.name }}
    next={next && { href: pluginHref(next.name), name: next.name }}
  />
</Base>
