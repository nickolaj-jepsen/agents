---
/**
 * A harness's logo, drawn from the sprite in Base.astro and set in `currentColor`, so the
 * colour is the caller's (`.k.claude`, `.k.pi`). Decorative: the name goes beside it.
 */
import type { Harness } from '../lib/content.ts';

interface Props {
  h: Harness;
}
const { h } = Astro.props;
// The svg's own viewBox is the logo's shape (the symbol is drawn to fill it), so no whitespace
// is left around a wide one.
const box = { claude: '0 0 24 15', pi: '0 0 24 24' }[h];
---

<svg class={`gl ${h}`} viewBox={box} aria-hidden="true" focusable="false"><use href={`#h-${h}`} /></svg>
