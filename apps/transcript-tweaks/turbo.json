{
  "extends": ["//"],
  "tasks": {
    "build": {
      "command": ["node", "../../lib/tools/build/build.ts"]
    },
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"]
    },
    "check-types": {
      "command": ["./node_modules/.bin/tsc", "-b", "tsconfig.json"]
    },
    "e2e": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "test", "transcript-tweaks"]
    },
    "e2e:update": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "test", "transcript-tweaks", "--update"]
    },
    "media": {
      "command": [
        "nix",
        "run",
        "../..#media",
        "--",
        "node",
        "../../lib/tools/drive/drive.ts",
        "record",
        "transcript-tweaks",
        "--harness",
        "terminal"
      ],
      "outputs": ["$TURBO_ROOT$/apps/site/media/transcript-tweaks/**"]
    }
  }
}
