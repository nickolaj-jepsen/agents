{
  "name": "@nickolaj-jepsen/claude-peers",
  "version": "0.2.0",
  "description": "Make a pi session a peer in Claude Code's cross-session messaging: list_agents and send_message reach Claude Code and other pi sessions on this machine",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "devDependencies": {
    "@agents/build": "workspace:*",
    "@agents/drive": "workspace:*",
    "@agents/kit-core": "workspace:*",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ]
  }
}
