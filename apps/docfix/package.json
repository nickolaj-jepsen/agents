{
  "name": "@nickolaj-jepsen/docfix",
  "version": "0.0.1",
  "description": "Agents file doc suggestions instead of editing docs outside their change; /docs reviews them and hands an apply back to the agent",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "devDependencies": {
    "@agents/build": "workspace:*",
    "@agents/drive": "workspace:*",
    "@agents/kit-band": "workspace:*",
    "@agents/kit-buttons": "workspace:*",
    "@agents/kit-core": "workspace:*",
    "@agents/kit-detail": "workspace:*",
    "@agents/kit-frame": "workspace:*",
    "@agents/kit-list": "workspace:*",
    "@agents/kit-notice": "workspace:*",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "agentTools": {
    "subagents": true
  },
  "claude": {
    "name": "docfix",
    "description": "Agents file doc suggestions instead of editing docs outside their change; /docs reviews them and hands an apply back to the agent",
    "author": {
      "name": "Nickolaj Jepsen"
    },
    "types": "./src/claude/types.d.ts"
  },
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ]
  }
}
