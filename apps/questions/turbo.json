{
  "extends": ["//"],
  "tasks": {
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"]
    },
    "build": {
      "command": ["node", "../../lib/tools/build/build.ts"]
    },
    "e2e": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "test", "questions"]
    },
    "e2e:update": {
      "command": ["node", "../../lib/tools/drive/drive.ts", "test", "questions", "--update"]
    },
    "media": {
      "command": [
        "nix",
        "run",
        "../..#media",
        "--",
        "node",
        "../../lib/tools/drive/drive.ts",
        "record",
        "questions",
        "--harness",
        "terminal"
      ],
      "outputs": ["$TURBO_ROOT$/apps/site/media/questions/**"]
    }
  }
}
