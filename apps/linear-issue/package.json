{
  "name": "@nickolaj-jepsen/linear-issue",
  "version": "0.2.0",
  "description": "Draft a Linear issue from a note or the recent conversation with /linear, review it in a sheet, and file it",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "devDependencies": {
    "@agents/build": "workspace:*",
    "@agents/drive": "workspace:*",
    "@agents/kit-band": "workspace:*",
    "@agents/kit-buttons": "workspace:*",
    "@agents/kit-card": "workspace:*",
    "@agents/kit-core": "workspace:*",
    "@agents/kit-detail": "workspace:*",
    "@agents/kit-fields": "workspace:*",
    "@agents/kit-frame": "workspace:*",
    "@agents/kit-list": "workspace:*",
    "@agents/kit-notice": "workspace:*",
    "@agents/kit-prose": "workspace:*",
    "@agents/kit-sheet": "workspace:*",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "claude": {
    "name": "linear-issue",
