---
import type { GetStaticPaths } from 'astro';
import Shell from '../../../../components/catalog/Shell.astro';
import Renders from '../../../../components/catalog/Renders.astro';
import { catalogHref, components, HARNESSES, sizeKey, sizesOf, type Component, type Story } from '../../../../lib/catalog.ts';

export const getStaticPaths = (() =>
  components.flatMap((c) =>
    c.stories.map((s, i) => ({
      params: { id: c.id, state: s.state },
      props: { c, s, prev: c.stories[i - 1], next: c.stories[i + 1], index: i },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  c: Component;
  s: Story;
  prev?: Story;
  next?: Story;
  index: number;
}
const { c, s, prev, next, index } = Astro.props;
const sizes = sizesOf([s]);
const size = sizes[0];
const about = HARNESSES.map((h) => s.by[h]?.about).find(Boolean);
const shows = c.features.filter((f) => HARNESSES.some((h) => f.story[h] === s.id));
const both = HARNESSES.every((h) => (s.shots[h]?.length ?? 0) > 0);
---

<Shell
  title={`${s.id} · Components`}
  description={about ?? `${c.name}: ${s.state}`}
  current={c}
  story={s}
  crumbs={[{ name: c.name, href: catalogHref(c) }, { name: s.state }]}
>
  <header class="lede">
    <h1 class="mono">{s.state}</h1>
    {about && <p class="lead">{about}</p>}
    {
      shows.length > 0 && (
        <p class="sub demonstrates">
          Shows:{' '}
          {shows.map((f, i) => (
            <>
              {i > 0 && '; '}
              <a class="lnk" href={`${catalogHref(c)}#compat`}>
                {f.label}
              </a>
            </>
          ))}
        </p>
      )
    }
  </header>

  <div class="bar story-bar">
    {
      sizes.length > 0 && (
        <div class="ctl">
          <span class="label">Terminal size</span>
          <div class="seg" role="group" aria-label="Terminal size" data-sizes data-js hidden>
            {sizes.map((x, i) => (
              <button type="button" data-set-size={sizeKey(x)} aria-pressed={i === 0 ? 'true' : 'false'}>
                {sizeKey(x)}
              </button>
            ))}
          </div>
          <noscript>
            <span class="mono">{size && sizeKey(size)}</span>
          </noscript>
        </div>
      )
    }
    {
      both && (
        <div class="ctl" data-js hidden>
          <span class="label">Layout</span>
          <div class="seg" role="group" aria-label="Layout">
            <button type="button" data-set-lay="side" aria-pressed="true">Side by side</button>
            <button type="button" data-set-lay="stack" aria-pressed="false">Stacked</button>
            <button type="button" data-set-lay="flip" aria-pressed="false" title="Flip (f)">Flip</button>
          </div>
        </div>
      )
    }
    <button type="button" class="seg-btn" data-actual aria-pressed="false" data-js hidden>Actual size</button>
    <span class="grow"></span>
    <span class="sub pos">{index + 1} of {c.stories.length}</span>
    <nav class="steps" aria-label="Stories">
      {prev ? <a href={catalogHref(c, prev)} rel="prev" data-key="prev" title={`${prev.state} (k)`}>← {prev.state}</a> : <span aria-disabled="true">←</span>}
      {next ? <a href={catalogHref(c, next)} rel="next" data-key="next" title={`${next.state} (j)`}>{next.state} →</a> : <span aria-disabled="true">→</span>}
    </nav>
  </div>

  <div class="story-stage" data-lay="side">
    <Renders c={c} s={s} size={size} eager />
    <p class="sub flip-hint" hidden>Hold the picture, or press <kbd>f</kbd>, to see the other harness in the same place.</p>
  </div>
</Shell>
