---
import Shell from '../../components/catalog/Shell.astro';
import Mark from '../../components/catalog/Mark.astro';
import Toolbar from '../../components/catalog/Toolbar.astro';
import Status from '../../components/catalog/Status.astro';
import { catalogHref, components, differs, HARNESSES, TITLES, type Component, type Harness } from '../../lib/catalog.ts';
import { github } from '../../lib/content.ts';

const counts = (c: Component, h: Harness) => {
  const n = { yes: 0, partial: 0, no: 0 };
  for (const f of c.features) n[f.support[h].status === 'planned' ? 'no' : f.support[h].status]++;
  return n;
};
const rendered = (c: Component, h: Harness) => c.stories.filter((s) => (s.shots[h]?.length ?? 0) > 0).length;
const total = Object.fromEntries(
  HARNESSES.map((h) => {
    const n = { yes: 0, partial: 0, no: 0, r: 0 };
    for (const c of components) {
      const k = counts(c, h);
      n.yes += k.yes;
      n.partial += k.partial;
      n.no += k.no;
      n.r += rendered(c, h);
    }
    return [h, n];
  }),
) as Record<Harness, { yes: number; partial: number; no: number; r: number }>;
const stories = components.reduce((n, c) => n + c.stories.length, 0);
const diffs = components.reduce((n, c) => n + c.features.filter(differs).length, 0);
const elsewhere = [
  ['AGENTS.md', 'What an agent working here reads first'],
  ['e2e/README.md', 'The end-to-end screens and site media'],
  ['kit/README.md', 'The UI kit, and how this catalogue is built'],
  ['skills/agent-plugin-dev/references/style.md', 'The house style of plugin screens'],
] as const;
const chips = [
  ['yes', '✓', 'yes'],
  ['partial', '~', 'partial'],
  ['no', '✗', 'no'],
] as const;
---

<Shell title="Developers" overview description="How the agents repo is built: the shared UI kit's components in pi and in Claude Code, and the developer notes.">
  <header class="lede">
    <h1>Developers</h1>
    <p class="lead">
      The shared UI kit, each component in pi and in Claude Code side by side. The notes for working on
      the repo are in the sidebar.
    </p>
    <p class="sub legend">
      <span><Mark h="claude" state="on" /> Claude Code</span>
      <span><Mark h="pi" state="on" /> pi</span>
      <span>lit has it, dim not yet, struck not possible</span>
      <span>counts are features: ✓ yes, ~ partial, ✗ no</span>
    </p>
  </header>

  <Toolbar />

  <div class="table scroll" role="region" aria-label="Components by harness" tabindex="0">
    <table class="matrix">
      <thead>
        <tr>
          <th scope="col">Component</th>
          {HARNESSES.map((h) => <th scope="col" class={`h-${h}`}>{TITLES[h]}</th>)}
          <th scope="col">Features that differ</th>
        </tr>
      </thead>
      <tbody>
        {
          components.map((c) => {
            const nd = c.features.filter(differs).length;
            return (
              <tr>
                <th scope="row">
                  <a href={catalogHref(c)}>{c.name}</a>
                  <span class="purpose">{c.purpose}</span>
                </th>
                {HARNESSES.map((h) => {
                  const n = counts(c, h);
                  return (
                    <td class={`h-${h}`}>
                      <div class="cellrow">
                        {c.impl[h].state !== 'exists' && <Status status={c.impl[h].state} />}
                        {c.impl[h].state !== 'none' && (
                          <span class="counts">
                            {chips
                              .filter(([k]) => n[k] > 0)
                              .map(([k, g, t]) => (
                                <span class={`count ${k}`} title={`${n[k]} ${t}`}>
                                  <span aria-hidden="true">{g}</span>
                                  {n[k]}
                                  <span class="vh"> {t}</span>
                                </span>
                              ))}
                          </span>
                        )}
                      </div>
                      <div class="note">
                        {c.impl[h].state === 'none' ? (
                          c.impl[h].reason
                        ) : (
                          <>
                            {rendered(c, h)} of {c.stories.length} stories rendered ·{' '}
                            {c.impl[h].exports.map((e, i) => (
                              <>
                                {i > 0 && ', '}
                                <code>{e}</code>
                              </>
                            ))}
                          </>
                        )}
                      </div>
                    </td>
                  );
                })}
                <td>{nd ? <a href={catalogHref(c)}>{nd} of {c.features.length}</a> : <span class="dim">none</span>}</td>
              </tr>
            );
          })
        }
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">All</th>
          {
            HARNESSES.map((h) => (
              <td class={`h-${h}`}>
                <div class="cellrow">
                  <span class="counts">
                    {chips
                      .filter(([k]) => total[h][k] > 0)
                      .map(([k, g, t]) => (
                        <span class={`count ${k}`} title={`${total[h][k]} ${t}`}>
                          <span aria-hidden="true">{g}</span>
                          {total[h][k]}
                          <span class="vh"> {t}</span>
                        </span>
                      ))}
                  </span>
                </div>
                <div class="note">
                  {total[h].r} of {stories} stories rendered
                </div>
              </td>
            ))
          }
          <td>{diffs} features</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="prose cat-about">
    <p>
      Each component's manifest is in <a href={github('kit/catalog/components/')}><code>kit/catalog/components/</code></a>; the renders come from the kit's end-to-end scenarios, cropped to the component, and the props from the kits' doc comments. <code>just catalog</code> rebuilds all of it (the Pages workflow does, before every build), and <a href={github('kit/README.md')}><code>kit/README.md</code></a> says how to add a component. Agents read the same model as <a href={github('kit/catalog/COMPONENTS.md')}><code>COMPONENTS.md</code></a>.
    </p>
  </div>
  <section class="cat-about" aria-labelledby="repo-h">
    <h2 class="side-h sc" id="repo-h">In the repo</h2>
    <ul class="repo-list">
      {
        elsewhere.map(([path, what]) => (
          <li>
            <a href={github(path)}><code>{path}</code></a> <span class="sub">{what}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Shell>
