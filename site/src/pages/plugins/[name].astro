---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Command from '../../components/Command.astro';
import Marks from '../../components/Marks.astro';
import Media from '../../components/Media.astro';
import Pager from '../../components/Pager.astro';
import { bodyAfterTagline, content, github, harnesses, HARNESS, href, pluginHref, type Plugin } from '../../lib/content.ts';
import { renderInline, renderMarkdown } from '../../lib/markdown.ts';

export const getStaticPaths = (() =>
  content().plugins.map((plugin, i, all) => ({
    params: { name: plugin.name },
    props: { plugin, prev: all[i - 1], next: all[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  plugin: Plugin;
  prev?: Plugin;
  next?: Plugin;
}
const { plugin: p, prev, next } = Astro.props;
const file = `${p.path}/README.md`;
const tagline = await renderInline(p.tagline, file);
const requires = await Promise.all(p.requires.map((r) => renderInline(r, file)));
const body = await renderMarkdown(bodyAfterTagline(p), file);
const installs = (['claude', 'pi'] as const).filter((h) => p.install[h]);
// With media, the rail sits beside the lede and the media spans both columns; without, the rail runs beside the body.
const hasMedia = !!(p.media?.video || p.media?.stills.length);
---

<Base title={p.name} description={p.tagline.replace(/`/g, '')} nav="plugins">
  <div class:list={["spread", { "with-media": hasMedia }]}>
  <header class="lede">
    <p class="crumb"><a href={href('#plugins')}>Plugins</a></p>
    <h1 class="mono">{p.name}</h1>
    <p class="lead" set:html={tagline} />
  </header>

  <dl class="facts rail">
    <dt>Runs in</dt>
    <dd><Marks harnesses={harnesses(p)} /></dd>
    {
      installs.length > 0 && (
        <>
          <dt>Install</dt>
          <dd>
            {installs.map((h) => (
              <div>
                {installs.length > 1 && <span class="cmd-label">{HARNESS[h]}</span>}
                <Command command={p.install[h]!} what={`${p.name} for ${HARNESS[h]}`} />
              </div>
            ))}
            {p.install.claude && (
              <p class="sub">
                Once per machine first: <code>claude plugin marketplace add nickolaj-jepsen/agents</code>
              </p>
            )}
          </dd>
        </>
      )
    }
    {
      requires.length > 0 && (
        <>
          <dt>Needs</dt>
          <dd>
            <ul class="plain">
              {requires.map((r) => (
                <li set:html={r} />
              ))}
            </ul>
          </dd>
        </>
      )
    }
    <dt>Source</dt>
    <dd><a href={github(`${p.path}/`)}><code>{p.path}/</code></a> on GitHub</dd>
  </dl>

  {hasMedia && <div class="span"><Media plugin={p} /></div>}

  <div class="prose body" set:html={body} />
  </div>

  <Pager
    label="Plugins"
    prev={prev && { href: pluginHref(prev.name), name: prev.name }}
    next={next && { href: pluginHref(next.name), name: next.name }}
  />
</Base>
