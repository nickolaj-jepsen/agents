---
/**
 * The catalogue's controls, one sticky bar for the whole page: the harness, the terminal size, how
 * The harness switch is also the layout: side by side or stacked show both harnesses,
 * for every story and props column, and a harness shows it alone. It starts hidden; catalog.ts shows it.
 */
import HarnessSwitch from '../HarnessSwitch.astro';
import { sizeKey } from '../../lib/catalog.ts';

interface Props {
  /** The terminal sizes the stories were drawn at; none, or one, hides the size switch. */
  sizes?: { w: number; h: number }[];
  /** The page has two harnesses' columns to arrange (a component's stories and props). */
  layout?: boolean;
  /** The page has renders, which can be shown at their own size. */
  renders?: boolean;
}
const { sizes = [], layout = false, renders = false } = Astro.props;
---

<div class="toolbar" data-js hidden>
  <HarnessSwitch options={['claude', 'pi']} both layouts={layout} />
  {
    sizes.length > 1 && (
      <div class="ctl">
        <div class="seg box" role="group" aria-label="Terminal size, columns by rows" title="Terminal size, columns by rows" data-sizes>
          {sizes.map((x, i) => (
            <button type="button" data-set-size={sizeKey(x)} aria-pressed={i === 0 ? 'true' : 'false'}>
              {sizeKey(x)}
            </button>
          ))}
        </div>
      </div>
    )
  }
</div>
