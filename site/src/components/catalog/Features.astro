---
/**
 * The features a story shows, as one line that opens into their compatibility: for each, what
 * each harness does and the caveat. A `<details>`, so it needs no script.
 */
import Status from './Status.astro';
import { differs, HARNESSES, TITLES, type Component, type Story } from '../../lib/catalog.ts';

interface Props {
  c: Component;
  s: Story;
  /** The story's own line, above it: a feature named the same is not said twice. */
  about?: string;
}
const { c, s, about } = Astro.props;
const shown = c.features.filter((f) => HARNESSES.some((h) => f.story[h] === s.id));
const nd = shown.filter(differs).length;
const same = (a: string, b?: string) => !!b && a.trim().replace(/\.$/, '').toLowerCase() === b.trim().replace(/\.$/, '').toLowerCase();
const what = shown.filter((f) => !same(f.label, about)).map((f) => f.label);
---

{
  shown.length > 0 && (
    <details class="feats">
      <summary>
        <span class="lbl">{shown.length === 1 ? 'Feature' : `${shown.length} features`}</span>
        {what.length > 0 && <span class="what">{what.join(' · ')}</span>}
        {nd > 0 && <span class="flag">{nd === 1 ? '1 differs' : `${nd} differ`}</span>}
      </summary>
      <table class="compat">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            {HARNESSES.map((h) => <th scope="col" data-h={h}>{TITLES[h]}</th>)}
          </tr>
        </thead>
        <tbody>
          {shown.map((f) => (
            <tr class:list={{ differs: differs(f) }}>
              <th scope="row">
                {f.label}
                {differs(f) && <span class="flag">differs</span>}
              </th>
              {HARNESSES.map((h) => (
                <td data-h={h}>
                  <Status status={f.support[h].status} />
                  {f.support[h].note && <div class="note">{f.support[h].note}</div>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </details>
  )
}
