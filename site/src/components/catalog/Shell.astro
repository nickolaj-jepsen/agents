---
/**
 * The developer pages' shell: the site's Base and a sidebar of the kit's components (the current
 * one's stories and props under it) and the docs. The page is as wide as every other, masthead
 * included; the sidebar hangs in the margin to its left when the margin holds it, else it takes
 * its place in the column. Below 64rem it follows the page, and a menu at the top (`.cat-jump`)
 * stands in for it. The pages' controls are Toolbar.astro, in the slot.
 */
import Base from '../../layouts/Base.astro';
import { catalogHref, components, type Component } from '../../lib/catalog.ts';
import { content, docHref, href } from '../../lib/content.ts';
import '../../styles/catalog.css';

interface Props {
  title: string;
  description: string;
  /** The component whose page this is. */
  current?: Component;
  /** The doc whose page this is. */
  doc?: string;
  /** The overview, which has no trail of its own. */
  overview?: boolean;
  /** Breadcrumb trail after "Developers", each a link but the last. */
  crumbs?: { name: string; href?: string }[];
}
const { title, description, current, doc, overview = false, crumbs = [] } = Astro.props;
const docs = content().docs;
---

<Base title={title} description={description} nav="dev" mainClass="catalog">
  <div class="kc">
    <div class="cat-main">
      <div class="cat-top">
        <nav class="crumb" aria-label="Breadcrumb">
          {
            overview ? (
              <span aria-current="page">Developers</span>
            ) : (
              <a href={href('dev/')}>Developers</a>
            )
          }
          {
            crumbs.map((c, i) => (
              <>
                {' / '}
                {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
              </>
            ))
          }
        </nav>
        <details class="cat-jump">
          <summary>{current ? current.name : overview ? 'Overview' : (docs.find((d) => d.slug === doc)?.title ?? 'Pages')}</summary>
          <div class="jump-cols">
            <ul>
              <li><a href={catalogHref()} aria-current={overview ? 'page' : undefined}>Overview</a></li>
              {components.map((c) => (
                <li><a href={catalogHref(c)} aria-current={c === current ? 'page' : undefined}>{c.name}</a></li>
              ))}
            </ul>
            <ul>
              {docs.map((d) => (
                <li><a href={docHref(d.slug)} aria-current={d.slug === doc ? 'page' : undefined}>{d.title}</a></li>
              ))}
            </ul>
          </div>
        </details>
      </div>
      <slot />
    </div>

    <nav class="cat-side" aria-label="Developer pages">
      <h2 class="side-h sc">UI kit</h2>
      <ul class="cat-list">
        <li>
          <a href={catalogHref()} class="comp" aria-current={overview ? 'page' : undefined}><span class="name">Overview</span></a>
        </li>
        {
          components.map((c) => (
            <li class:list={{ here: c === current }}>
              <a href={catalogHref(c)} class="comp" aria-current={c === current ? 'page' : undefined}>
                <span class="name">{c.name}</span>
              </a>
              <ul class="stories">
                {c.stories.map((s) => (
                  <li>
                    <a href={catalogHref(c, s)}>
                      <span class="name">{s.state}</span>
                    </a>
                  </li>
                ))}
                <li class="to-props">
                  <a href={`${catalogHref(c)}#props`}>
                    <span class="name">Props</span>
                  </a>
                </li>
              </ul>
            </li>
          ))
        }
      </ul>
      <h2 class="side-h sc">Docs</h2>
      <ul class="cat-list">
        {
          docs.map((d) => (
            <li>
              <a href={docHref(d.slug)} class="comp" aria-current={d.slug === doc ? 'page' : undefined}>
                <span class="name">{d.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <script>
    import '../../client/catalog.ts';
  </script>
</Base>
