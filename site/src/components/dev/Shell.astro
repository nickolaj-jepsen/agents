---
/**
 * The developer pages' shell: the site's Base, a breadcrumb, and a sidebar of the docs. Below 64rem
 * the sidebar follows the page, and a menu at the top (`.cat-jump`) stands in for it.
 */
import Base from '../../layouts/Base.astro';
import { content, docHref, href } from '../../lib/content.ts';
import '../../styles/dev.css';

interface Props {
  title: string;
  description: string;
  /** The doc whose page this is. */
  doc?: string;
  /** The overview, which has no trail of its own. */
  overview?: boolean;
  /** Breadcrumb trail after "Developers", each a link but the last. */
  crumbs?: { name: string; href?: string }[];
}
const { title, description, doc, overview = false, crumbs = [] } = Astro.props;
const docs = content().docs;
const current = docs.find((d) => d.slug === doc)?.title;
---

<Base title={title} description={description} nav="dev" mainClass="dev">
  <div class="kc">
    <div class="cat-main">
      <div class="cat-top">
        <nav class="crumb" aria-label="Breadcrumb">
          {
            overview ? (
              <span aria-current="page">Developers</span>
            ) : (
              <a href={href('dev/')}>Developers</a>
            )
          }
          {
            crumbs.map((c, i) => (
              <>
                {' / '}
                {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
              </>
            ))
          }
        </nav>
        <details class="cat-jump">
          <summary>{current ?? (overview ? 'Overview' : 'Pages')}</summary>
          <div class="jump-cols">
            <ul>
              {
                docs.map((d) => (
                  <li>
                    <a href={docHref(d.slug)} aria-current={d.slug === doc ? 'page' : undefined}>
                      {d.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>
      <slot />
    </div>

    <nav class="cat-side" aria-label="Developer pages">
      <h2 class="side-h sc">Docs</h2>
      <ul class="cat-list">
        {
          docs.map((d) => (
            <li>
              <a href={docHref(d.slug)} class="comp" aria-current={d.slug === doc ? 'page' : undefined}>
                <span class="name">{d.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>
