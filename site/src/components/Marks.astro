---
/** The harnesses a plugin runs in: the logo in the harness's colour, then its name. */
import Glyph from './Glyph.astro';
import { HARNESS, type Harness } from '../lib/content.ts';

interface Props {
  harnesses: Harness[];
  /** Logos only, each named for a screen reader. */
  short?: boolean;
}
const { harnesses, short = false } = Astro.props;
---

<span class:list={["marks", { short }]}>
  {
    harnesses.map((h) => (
      <span class={`hm ${h}`} title={short ? HARNESS[h] : undefined}>
        <span class="k"><Glyph h={h} /></span>
        {short ? <span class="vh">{HARNESS[h]}</span> : HARNESS[h]}
      </span>
    ))
  }
</span>
