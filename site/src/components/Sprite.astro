---
/** The harness logos, once per page; Glyph.astro refers to them. Stroked, so they take the text colour. */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <!-- Claude Code: a spark of twelve uneven rays. -->
  <symbol id="h-claude" viewBox="0 0 24 24">
    <path
      d="M12.27 9.82L13.17 2.47M13.32 10.24L16.09 6.57M14.03 11.14L19.92 8.64M14.18 12.27L18.15 12.76M13.76 13.32L19.67 17.78M12.86 14.03L14.74 18.44M11.73 14.18L10.88 21.13M10.68 13.76L8.15 17.11M9.97 12.86L2.98 15.83M9.82 11.73L5.45 11.2M10.24 10.68L4.97 6.7M11.14 9.97L9.19 5.37"
      fill="none"
      stroke="currentColor"
      stroke-width="2.3"
      stroke-linecap="round"></path>
  </symbol>
  <!-- pi: the letter, its right leg hooked. -->
  <symbol id="h-pi" viewBox="0 0 24 24">
    <path
      d="M4 6.5H20M9 6.5L8.2 19M15 6.5V15.5Q15 19 18.5 19"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </symbol>
</svg>
