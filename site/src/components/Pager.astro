---
/** Previous and next in a list of pages. */
interface Link {
  href: string;
  name: string;
}
interface Props {
  /** What the list is, for the nav's name. */
  label: string;
  prev?: Link;
  next?: Link;
  /** A way back to the whole list, between the two. */
  all?: Link;
}
const { label, prev, next, all } = Astro.props;
---

{
  (prev || next || all) && (
    <nav class="pager" aria-label={`${label}, previous and next`}>
      {prev && (
        <div class="prev">
          <span class="dir">Previous</span>
          <a href={prev.href} rel="prev">
            {prev.name}
          </a>
        </div>
      )}
      {all && (
        <div class="all">
          <a href={all.href}>{all.name}</a>
        </div>
      )}
      {next && (
        <div class="next">
          <span class="dir">Next</span>
          <a href={next.href} rel="next">
            {next.name}
          </a>
        </div>
      )}
    </nav>
  )
}
