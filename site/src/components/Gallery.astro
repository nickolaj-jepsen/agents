---
/**
 * A plugin's media as one stage: the item shown full width with its caption, a strip of thumbnails
 * under it, and, when both harnesses have media, a switch between them. When Claude Code has
 * pictures in VS Code too, a second switch, Terminal or VS Code, follows as a choice within Claude
 * Code. Without script every item is shown, one under another. gallery.ts does the switching.
 */
import Glyph from './Glyph.astro';
import HarnessSwitch from './HarnessSwitch.astro';
import Plate from './Plate.astro';
import { HARNESS, SURFACE, mediaUrl, type Harness, type Plugin, type Surface } from '../lib/content.ts';

interface Props {
  plugin: Plugin;
}
const { plugin } = Astro.props;
type Item = {
  kind: 'video' | 'image';
  src: string;
  poster?: string;
  thumb: string;
  width: number;
  height: number;
  caption: string;
  harness: Harness;
  surface: Surface;
};
const media = plugin.media;
const items: Item[] = [
  ...(media?.videos ?? []).map((v) => ({
    kind: 'video' as const,
    src: mediaUrl(v.mp4),
    poster: mediaUrl(v.poster),
    thumb: mediaUrl(v.poster),
    width: v.width,
    height: v.height,
    caption: v.caption,
    harness: v.harness,
    surface: 'terminal' as const,
  })),
  ...(media?.stills ?? []).map((s) => ({
    kind: 'image' as const,
    src: mediaUrl(s.png),
    thumb: mediaUrl(s.png),
    width: s.width,
    height: s.height,
    caption: s.caption,
    harness: s.harness,
    surface: s.surface,
  })),
];
const harnesses = (['claude', 'pi'] as const).filter((h) => items.some((i) => i.harness === h));
// Claude Code's surfaces: a switch only when it has pictures in both.
const surfaces = (['terminal', 'vscode'] as const).filter((s) => items.some((i) => i.harness === 'claude' && i.surface === s));
---

{
  items.length > 0 && (
    <section class="gallery" aria-label={`${plugin.name} in use`} data-gallery data-default={harnesses[0]}>
      {(harnesses.length > 1 || surfaces.length > 1) && (
        <div class="g-bar">
          {harnesses.length > 1 ? (
            <HarnessSwitch options={harnesses} />
          ) : (
            <span class="g-of">
              <span class="k claude">
                <Glyph h="claude" />
              </span>
              {HARNESS.claude}
            </span>
          )}
          {surfaces.length > 1 && (
            <div class="g-surface" data-surfaces data-js hidden>
              <span class="g-in" aria-hidden="true">
                in
              </span>
              <div class="seg box" role="group" aria-label={`${HARNESS.claude} in`}>
                {surfaces.map((s, i) => (
                  <button type="button" data-set-s={s} aria-pressed={i === 0 ? 'true' : 'false'}>
                    {SURFACE[s]}
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
      <div class="g-stage">
        {items.map((it, i) => (
          <div class="g-item" data-i={i} data-h={it.harness} data-s={it.surface}>
            {it.kind === 'video' ? (
              <Plate src={it.src} poster={it.poster} width={it.width} height={it.height} alt={it.caption} />
            ) : (
              <Plate src={it.src} width={it.width} height={it.height} alt={it.caption} eager={i === 0} />
            )}
            <div class="g-cap">
              <p>
                {harnesses.length > 1 || plugin.harness.claude !== plugin.harness.pi ? (
                  <span class={`k ${it.harness}`} title={HARNESS[it.harness]}>
                    <Glyph h={it.harness} />
                  </span>
                ) : null}
                {it.caption}
              </p>
            </div>
          </div>
        ))}
      </div>
      {items.length > 1 && (
        <ol class="g-thumbs" data-js hidden aria-label="Pictures">
          {items.map((it, i) => (
            <li data-h={it.harness}>
              <button type="button" data-show={i} aria-label={`${it.kind === 'video' ? 'Video' : 'Picture'}: ${it.caption}`} aria-pressed="false">
                <img src={it.thumb} width={it.width} height={it.height} alt="" loading="lazy" decoding="async" />
                {it.kind === 'video' && (
                  <span class="play" aria-hidden="true">
                    ▶
                  </span>
                )}
              </button>
            </li>
          ))}
        </ol>
      )}
    </section>
  )
}

<script>
  import '../client/gallery.ts';
</script>
