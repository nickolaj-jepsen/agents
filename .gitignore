node_modules/
# Build output (`pnpm turbo run build`); it holds the mod API types Claude Code lays when it loads a mod from its folder.
apps/*/dist/
lib/kits/catalog/dist/
result
result-*
.direnv/
# The site's build output and the types Astro writes.
apps/site/dist/
apps/site/.astro/
# Recorded, not committed: `turbo run media` writes them, as the Pages workflow does before it builds.
apps/site/media/
# The site's content model, written by `turbo run site-data` from the markdown this repo holds.
apps/site/data/

# Turborepo
.turbo
# Python: the uv environment and tool caches.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
