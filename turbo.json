{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalTaskCommand": true,
    "experimentalPythonWorkspaces": true
  },
  // CI signs what it uploads with TURBO_REMOTE_CACHE_SIGNATURE_KEY; a machine that reads the remote
  // cache needs the same key.
  "remoteCache": { "signature": true },
  "globalDependencies": [".node-version"],
  "tasks": {
    // What a package contributes to the tasks of those that import it: its sources, not its tests,
    // its screen scenarios and snapshots or its README. A task that depends on `^topo` is keyed on
    // the packages it imports, so an edit reruns what reaches it and nothing else. Never key a task
    // on a file another task writes: turbo hashes a task's inputs before its dependencies run.
    "topo": {
      "dependsOn": ["^topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!e2e/**",
        "!src/e2e/**",
        "!**/__snapshots__/**",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!tsconfig.json",
        "!tsconfig.claude.json",
        "!vitest.config.ts",
        "!turbo.json"
      ]
    },
    // Each package installs its own tools and turbo's PATH holds only the root's `node_modules/.bin`,
    // so a package task names its tool by path (`./node_modules/.bin/tsc`), run from the package.
    // A package's build is a task of its own: an app's or the catalogue's bundle in `dist/` (see
    // lib/tools/build/build.ts), which `test:claude`, the e2e scenarios and the recordings load. What
    // it imports reaches it through `^topo`: the kit packages, and the build tool itself.
    "build": {
      "dependsOn": ["^topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!e2e/**",
        "!src/e2e/**",
        "!**/__snapshots__/**",
        "!**/*.spec.ts",
        "!tsconfig.json",
        "!tsconfig.claude.json",
        "!vitest.config.ts",
        "!turbo.json"
      ],
      // The engine writes `.claude-plugin/types` and `tsconfig.json` into `dist/` when it loads a
      // mod. They aren't build outputs; `types` keeps its own snapshot elsewhere.
      "outputs": ["dist/**", "!dist/.claude-plugin/types/**", "!dist/tsconfig.json"]
    },
    // `drive types` snapshots the engine's API declarations outside `dist/`, where other Claude
    // sessions can't rewrite them during a type check. The build, harness and pinned Claude
    // version reach this task as hashes.
    "types": {
      "dependsOn": ["^topo", "build"],
      "inputs": ["package.json"],
      "outputs": [".claude-types/**"]
    },
    // A package with a Claude half checks it too, against its `types` (its own `tsconfig.claude.json`).
    "check-types": {
      "command": ["./node_modules/.bin/tsc", "-b"],
      "dependsOn": ["topo", "types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.base.node.json",
        "!**/*.md",
        "!**/__snapshots__/**"
      ]
    },
    // A package's specs and what they import: not its README, scenarios or snapshots.
    "test": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!e2e/**", "!src/e2e/**", "!**/__snapshots__/**"]
    },
    "test:claude": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/lib/tools/build/claude-plugin-test.sh"]
    },
    // Screen tests, `drive test <package>`: the package's scenarios and snapshots, its build and the
    // kit packages and harness it imports. The flags of `drive test` are the command's, never the
    // environment's.
    "e2e": {
      "dependsOn": ["^topo", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!**/site.scenarios.ts",
        "!**/vscode.scenarios.ts",
        "!**/desktop.scenarios.ts",
        "!tsconfig.json",
        "!tsconfig.claude.json",
        "!**/*.spec.ts",
        "!turbo.json"
      ]
    },
    "e2e:update": {
      "dependsOn": ["build"],
      "cache": false
    },
    // Builds the recording environment (VS Code, fonts, tools), so nix has it before a recorder
    // asks. No outputs: its hash is the point. Every recording depends on it, so a recording from
    // another environment misses the cache.
    "//#media-env": {
      "command": ["nix", "build", ".#mediaEnvironment", "--no-link"],
      "inputs": ["pkgs/media-environment.nix", "devshell.nix", "flake.nix", "flake.lock"],
      "outputs": [],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME"
      ]
    },
    // Recordings, in `nix run .#media -- <command>`, the recording environment. Each app and kit
    // package that has some owns its `media` task (the terminal's demo, stills and crops) and each app
    // with VS Code pictures `media:vscode`, writing `apps/site/media/<package>/` and nothing else
    // (a kit package's: `apps/site/media/kit/<name>/`), which its `outputs` say. A recording is keyed
    // on its scenarios, the build it plays and the packages that reach it, and not on what only tests
    // and the other recorder read. The site's own `media` is all of them (apps/site/turbo.json).
    // CAST_*, E2E_VSCODE_* and FONTCONFIG_FILE are the environment's own, not passed through.
    "media": {
      "dependsOn": ["^topo", "build", "//#media-env", "@agents/drive#tui-test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!src/e2e/claude.scenarios.ts",
        "!src/e2e/pi.scenarios.ts",
        "!src/e2e/vscode.scenarios.ts",
        "!src/e2e/desktop.scenarios.ts",
        "!**/__snapshots__/**",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!tsconfig.json",
        "!tsconfig.claude.json",
        "!vitest.config.ts",
        "!turbo.json"
      ],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN"
      ]
    },
    // The VS Code pictures need a Linux compositor, and fail anywhere else: a skip that succeeded
    // with no pictures would be cached as the task's result, and restored on Linux.
    "media:vscode": {
      "dependsOn": ["^topo", "build", "//#media-env"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!src/e2e/claude.scenarios.ts",
        "!src/e2e/pi.scenarios.ts",
        "!src/e2e/desktop.scenarios.ts",
        "!**/__snapshots__/**",
        "!**/*.spec.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!tsconfig.json",
        "!tsconfig.claude.json",
        "!vitest.config.ts",
        "!turbo.json"
      ],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME",
        "XDG_RUNTIME_DIR"
      ]
    },
    "@agents/drive#tui-test": {
      "command": ["node", "fetch-tui-test.ts"],
      "inputs": ["fetch-tui-test.ts", "lib/tui-test-release.ts"],
      "outputs": ["node_modules/.cache/tui-test/**"]
    },
    // The root's dependencies are in every task's hash, so the root holds turbo alone. oxlint, oxfmt and
    // shellcheck live in `lib/tools/lint/` and the tasks name them by path; its `package.json` is their
    // input, which is where a bump of one shows.
    "//#lint": {
      "command": ["./lib/tools/lint/node_modules/.bin/oxlint", "--deny-warnings"],
      "inputs": [
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,vue,astro,svelte}",
        "lib/tools/lint/package.json",
        ".oxlintrc.json",
        ".gitignore",
        "!**/node_modules/**",
        "!.turbo/**",
        "!**/dist/**",
        "!apps/site/dist/**",
        "!apps/site/.astro/**",
        "!apps/site/media/**"
      ]
    },
    "//#fmt": {
      "command": [
        "./lib/tools/lint/node_modules/.bin/oxfmt",
        "--write",
        "**/*.{cjs,css,graphql,hbs,html,js,json,json5,jsonc,jsx,md,mdx,mjs,mustache,scss,ts,tsx,vue,yaml,yml}"
      ],
      "cache": false
    },
    "//#fmt:check": {
      "command": [
        "./lib/tools/lint/node_modules/.bin/oxfmt",
        "--check",
        "**/*.{cjs,css,graphql,hbs,html,js,json,json5,jsonc,jsx,md,mdx,mjs,mustache,scss,ts,tsx,vue,yaml,yml}"
      ],
      "inputs": [
        "**/*.{cjs,css,graphql,hbs,html,js,json,json5,jsonc,jsx,md,mdx,mjs,mustache,scss,ts,tsx,vue,yaml,yml}",
        ".oxfmtrc.json",
        ".gitignore",
        "!**/node_modules/**",
        "!.turbo/**",
        "!**/dist/**",
        "!apps/site/dist/**",
        "!apps/site/.astro/**",
        "!apps/site/media/**"
      ]
    },
    // Writes the committed files generated from sources: README.md, COMPONENTS.md and the kit index
    // in AGENTS.md (their freshness specs say so when they are stale).
    "//#readme": {
      "command": ["node", "lib/tools/build/readme.ts"],
      "cache": false
    },
    // `pnpm turbo run build`: every package's build, those files, the media and the site built from
    // them (`@agents/site#build` depends on every package and its `media`).
    "//#build": {
      "command": null,
      "dependsOn": ["//#readme", "//#catalog:docs", "@agents/site#build"]
    },
    "//#skills:refresh": {
      "command": ["node", "skills/agent-plugin-dev/scripts/refresh-docs.ts"],
      "cache": false
    },
    // COMPONENTS.md and the kit index in AGENTS.md, from the kits' manifests and sources. Both are
    // committed, so they are inputs too: a copy edited by hand is written again.
    "//#catalog:docs": {
      "command": ["node", "lib/kits/catalog/src/build.ts"],
      "inputs": [
        "lib/kits/**",
        "AGENTS.md",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/__pycache__/**",
        "!**/.venv/**",
        "!**/.*_cache/**",
        "!**/.claude-plugin/types/**",
        "!**/dist/**",
        "!**/*.actual.*",
        "!**/*.spec.ts",
        "!**/e2e/**"
      ],
      "outputs": ["AGENTS.md", "lib/kits/catalog/COMPONENTS.md"]
    },
    "//#kit-new": {
      "command": ["node", "lib/kits/new.ts"],
      "cache": false
    },
    "check": {
      "dependsOn": ["check-types", "test", "test:claude", "e2e"]
    },
    "//#check": {
      "dependsOn": ["//#fmt:check", "//#lint", "//#lint:sh", "agents-python#check"]
    },
    "agents-python#check-types": {
      "command": null
    },
    "run-handoff#check-types": {
      "command": null
    },
    "agents-python#check": {
      "command": null,
      "dependsOn": ["agents-python#lint:py", "agents-python#fmt:check", "run-handoff#test"]
    },
    "agents-python#lint:py": {
      "command": ["uv", "run", "--frozen", "ruff", "check"],
      "inputs": [
        "**/*.py",
        "pyproject.toml",
        "skills/*/scripts/pyproject.toml",
        "uv.lock",
        ".python-version"
      ]
    },
    "agents-python#fmt:check": {
      "command": ["uv", "run", "--frozen", "ruff", "format", "--check"],
      "inputs": [
        "**/*.py",
        "pyproject.toml",
        "skills/*/scripts/pyproject.toml",
        "uv.lock",
        ".python-version"
      ]
    },
    "agents-python#fmt": {
      "command": ["uv", "run", "--frozen", "ruff", "format"],
      "cache": false
    },
    "//#lint:sh": {
      "command": [
        "sh",
        "-c",
        "git ls-files -z \"*.sh\" | xargs -0 ./lib/tools/lint/node_modules/.bin/shellcheck -S warning"
      ],
      "inputs": ["**/*.sh", "lib/tools/lint/package.json"]
    },
    // Not part of `check`: the one task that needs nix. `nix flake check` builds every plugin
    // (`packages.plugins`, and each Claude half through `lib.mkClaudePlugin`), so it keys on the nix
    // files, the lockfile and the hash that pins it, and the sources nix builds from: the apps, the kits
    // and the build tool, less what only tests and recordings read. A stale `pkgs/pnpm-deps.hash` fails it;
    // `nix run .#update-deps-hash` rewrites it. CI runs it when this key misses (see
    // .github/workflows/ci.yml).
    "//#check:nix": {
      "command": [
        "sh",
        "-c",
        "nix flake check --print-build-logs || { status=$?; echo 'check:nix failed. If nix reported a hash mismatch in agents-pnpm-deps, the lockfile changed: run `nix run .#update-deps-hash` and commit pkgs/pnpm-deps.hash.' >&2; exit $status; }"
      ],
      "inputs": [
        "**/*.nix",
        "flake.lock",
        "pkgs/pnpm-deps.hash",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "apps/*/**",
        "lib/kits/*/**",
        "lib/tools/build/**",
        "!apps/site/**",
        "!lib/kits/catalog/**",
        "!**/e2e/**",
        "!**/src/e2e/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/.venv/**",
        "!**/dist/**",
        "!**/.claude-plugin/types/**",
        "!**/*.spec.ts"
      ],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME"
      ]
    }
  }
}
