{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalTaskCommand": true,
    "experimentalPythonWorkspaces": true
  },
  // CI signs what it uploads with TURBO_REMOTE_CACHE_SIGNATURE_KEY; a machine that reads the remote
  // cache needs the same key.
  "remoteCache": { "signature": true },
  "globalDependencies": [".node-version"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    // Each package installs its own tools and turbo's PATH holds only the root's `node_modules/.bin`,
    // so a package task names its tool by path (`./node_modules/.bin/tsc`), run from the package.
    // A package's build is a task of its own: an app's or the catalogue's bundle in `dist/` (see
    // lib/tools/build/build.ts), which `test:claude` and the e2e scenarios load. The kit's sources reach it
    // through `^topo`, so an edit to a component rebuilds what imports it. The engine writes
    // `.claude-plugin/types` and `tsconfig.json` into `dist/` when it loads a mod; a build keeps them
    // and a cache restore does not touch them.
    "build": {
      "dependsOn": ["^topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/lib/tools/build/build.ts",
        "!src/e2e/**",
        "!**/*.spec.ts",
        "!tsconfig.json",
        "!vitest.config.ts",
        "!turbo.json"
      ],
      "outputs": ["dist/**", "!dist/.claude-plugin/types/**", "!dist/tsconfig.json"]
    },
    "check-types": {
      "command": ["./node_modules/.bin/tsc", "-b"],
      "dependsOn": ["topo", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.base.node.json",
        "!**/*.md",
        "!**/__snapshots__/**"
      ]
    },
    "test": {
      "dependsOn": ["topo"]
    },
    "test:claude": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/lib/tools/build/claude-plugin-test.sh"]
    },
    "e2e": {
      "dependsOn": ["^topo", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/site.scenarios.ts",
        "!**/vscode.scenarios.ts",
        "!tsconfig.json",
        "!**/*.spec.ts"
      ],
      "env": ["E2E_UPDATE", "E2E_PNG", "E2E_TMP"],
      "passThroughEnv": ["E2E_JOBS", "E2E_JOBS_CLAUDE", "E2E_JOBS_PI", "E2E_KEEP", "E2E_TIMING"]
    },
    "e2e:update": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "E2E_JOBS",
        "E2E_JOBS_CLAUDE",
        "E2E_JOBS_PI",
        "E2E_KEEP",
        "E2E_PNG",
        "E2E_TMP"
      ]
    },
    // The root's dependencies are in every task's hash, so the root holds turbo alone. oxlint, oxfmt and
    // shellcheck live in `lib/tools/lint/` and the tasks name them by path; its `package.json` is their
    // input, which is where a bump of one shows.
    "//#lint": {
      "command": ["./lib/tools/lint/node_modules/.bin/oxlint", "--deny-warnings"],
      "inputs": [
        "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,vue,astro,svelte}",
        "lib/tools/lint/package.json",
        ".oxlintrc.json",
        ".gitignore",
        "!**/node_modules/**",
        "!.turbo/**",
        "!**/dist/**",
        "!apps/site/dist/**",
        "!apps/site/.astro/**",
        "!apps/site/media/**",
        "!apps/site/data/**"
      ]
    },
    "//#fmt": {
      "command": [
        "./lib/tools/lint/node_modules/.bin/oxfmt",
        "--write",
        "**/*.{cjs,css,graphql,hbs,html,js,json,json5,jsonc,jsx,md,mdx,mjs,mustache,scss,ts,tsx,vue,yaml,yml}"
      ],
      "cache": false
    },
    "//#fmt:check": {
      "command": [
        "./lib/tools/lint/node_modules/.bin/oxfmt",
        "--check",
        "**/*.{cjs,css,graphql,hbs,html,js,json,json5,jsonc,jsx,md,mdx,mjs,mustache,scss,ts,tsx,vue,yaml,yml}"
      ],
      "inputs": [
        "**/*.{cjs,css,graphql,hbs,html,js,json,json5,jsonc,jsx,md,mdx,mjs,mustache,scss,ts,tsx,vue,yaml,yml}",
        ".oxfmtrc.json",
        ".gitignore",
        "!**/node_modules/**",
        "!.turbo/**",
        "!**/dist/**",
        "!apps/site/dist/**",
        "!apps/site/.astro/**",
        "!apps/site/media/**",
        "!apps/site/data/**"
      ]
    },
    "//#readme": {
      "command": ["node", "lib/tools/build/readme.ts"],
      "cache": false
    },
    // Every mod and extension a driver can load, built: what the tasks that start a session depend on.
    "//#dist": {
      "command": null,
      "dependsOn": [
        "@nickolaj-jepsen/answer#build",
        "@nickolaj-jepsen/claude-compat#build",
        "@nickolaj-jepsen/docfix#build",
        "@nickolaj-jepsen/exa#build",
        "@nickolaj-jepsen/git-menu#build",
        "@nickolaj-jepsen/image-preview#build",
        "@nickolaj-jepsen/linear-issue#build",
        "@nickolaj-jepsen/questions#build",
        "@nickolaj-jepsen/spellfix#build",
        "@nickolaj-jepsen/transcript-tweaks#build",
        "@nickolaj-jepsen/worktree#build",
        "@agents/kit-catalog#build"
      ]
    },
    // `pnpm turbo run build` also rewrites the generated README.md (the invariants spec says so when it is stale).
    "//#build": {
      "command": null,
      "dependsOn": ["//#readme"]
    },
    "@agents/drive#tui-test": {
      "command": ["node", "fetch-tui-test.ts"],
      "inputs": ["fetch-tui-test.ts", "lib/tui-test-release.ts"],
      "outputs": ["node_modules/.cache/tui-test/**"]
    },
    // Turbo stops what a task leaves behind, so a session parked by `goto` dies with its task:
    // drive `goto`, `cap` and `keys` with `node lib/tools/drive/cli.ts` itself. This runs verbs that finish.
    "//#e2e:cli": {
      "command": ["node", "lib/tools/drive/cli.ts"],
      "dependsOn": ["//#dist", "@agents/drive#tui-test"],
      "cache": false,
      "passThroughEnv": [
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_VSCODE_SESSION",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ]
    },
    "//#e2e:vscode": {
      "command": ["node", "lib/tools/drive/vscode.ts"],
      "dependsOn": ["//#dist"],
      "cache": false,
      "passThroughEnv": [
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_VSCODE_SESSION",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ]
    },
    "//#e2e-live": {
      "command": ["node", "lib/tools/drive/cli.ts", "live"],
      "dependsOn": ["//#dist", "@agents/drive#tui-test"],
      "cache": false,
      "persistent": true,
      "interactive": true,
      "passThroughEnv": [
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_VSCODE_SESSION",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ]
    },
    "//#kit-live": {
      "command": ["node", "lib/tools/drive/cli.ts", "live", "kit", "--watch"],
      "dependsOn": ["//#dist", "@agents/drive#tui-test"],
      "cache": false,
      "persistent": true,
      "interactive": true,
      "passThroughEnv": [
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_VSCODE_SESSION",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ]
    },
    "//#answer-demo": {
      "command": ["node", "apps/answer/src/e2e/live.ts"],
      "dependsOn": ["//#dist", "@agents/drive#tui-test"],
      "cache": false,
      "persistent": true,
      "interactive": true,
      "passThroughEnv": [
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_VSCODE_SESSION",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ]
    },
    "//#claude-desktop-dev": {
      "command": ["node", "lib/tools/drive/desktop.ts"],
      "dependsOn": ["//#dist"],
      "cache": false,
      "passThroughEnv": [
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_VSCODE_SESSION",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ]
    },
    "//#capture-cast": {
      "command": ["nix", "run", ".#media", "--", "node", "lib/tools/drive/capture-cast.ts"],
      "cache": false
    },
    "//#plugin-docs": {
      "command": ["node", "skills/agent-plugin-dev/scripts/refresh-docs.ts"],
      "cache": false
    },
    "//#site-data": {
      "command": ["node", "lib/tools/build/site-data.ts"],
      "inputs": [
        "lib/tools/build/content.ts",
        "lib/tools/build/site-data.ts",
        ".claude-plugin/marketplace.json",
        "apps/*/package.json",
        "apps/*/README.md",
        "skills/**",
        "docs/**",
        "apps/site/media/*/media.json",
        "apps/site/media/*/media-vscode.json",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/__pycache__/**",
        "!**/.venv/**",
        "!**/.*_cache/**"
      ],
      "outputs": ["apps/site/data/content.json"]
    },
    "//#catalog": { "command": ["node", "lib/kits/catalog/src/build.ts"], "cache": false },
    "//#catalog:data": {
      "command": ["node", "lib/kits/catalog/src/build.ts", "--no-shots"],
      "inputs": [
        "lib/kits/**",
        "AGENTS.md",
        "apps/site/media/kit/crops.json",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/__pycache__/**",
        "!**/.venv/**",
        "!**/.*_cache/**",
        "!**/.claude-plugin/types/**",
        "!**/dist/**",
        "!**/*.actual.*",
        "!**/*.spec.ts"
      ],
      "outputs": ["apps/site/data/kit.json"]
    },
    // Builds the recording environment (VS Code, fonts, tools), so nix has it before a recorder
    // asks. No outputs: its hash is the point. Every recording depends on it, so a recording from
    // another environment misses the cache.
    "//#media-env": {
      "command": ["nix", "build", ".#mediaEnvironment", "--no-link"],
      "inputs": ["pkgs/media-environment.nix", "devshell.nix", "flake.nix", "flake.lock"],
      "outputs": [],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME"
      ]
    },
    // Record inside `nix run .#media -- <command>`, the recording environment. The recorders are
    // tasks of the drive package, not root tasks: a root task is keyed on this file, and a recording
    // is dear. `turbo run media` is all three; `site#build` reads whatever they left under apps/site/.
    "//#media": {
      "dependsOn": [
        "@agents/drive#media:kit",
        "@agents/drive#site-shots",
        "@agents/drive#site-vscode"
      ]
    },
    "@agents/drive#media:kit": {
      "command": [
        "nix",
        "run",
        ".#media",
        "--",
        "env",
        "E2E_UPDATE=1",
        "node",
        "../kits/catalog/src/build.ts"
      ],
      "dependsOn": ["//#dist", "//#media-env"],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "CAST_FFMPEG",
        "CAST_MESA",
        "SITE_JOBS",
        "E2E_JOBS",
        "E2E_JOBS_CLAUDE",
        "E2E_JOBS_PI",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_TMP",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ],
      "inputs": [
        "lib/**",
        "assets/**",
        "tui-test.toml",
        "run.ts",
        "e2e.spec.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/lib/kits/**",
        "$TURBO_ROOT$/AGENTS.md",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/__pycache__/**",
        "!**/.venv/**",
        "!**/.*_cache/**",
        "!**/.claude-plugin/types/**",
        "!**/dist/**",
        "!**/*.actual.*",
        "!**/.out/**",
        "!**/*.spec.ts",
        "!**/__snapshots__/**",
        "!**/turbo.json",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.claude-plugin/types/**",
        "!$TURBO_ROOT$/**/*.actual.*",
        "!$TURBO_ROOT$/**/turbo.json",
        "!$TURBO_ROOT$/**/*.spec.ts",
        "!$TURBO_ROOT$/**/*.test.ts",
        "!$TURBO_ROOT$/**/*.test.tsx",
        "!site-vscode.ts",
        "!vscode.ts",
        "!lib/vscode.ts",
        "!lib/vscode-scenario.ts",
        "!*/vscode.scenarios.ts"
      ],
      "outputs": ["$TURBO_ROOT$/apps/site/media/kit/**", "$TURBO_ROOT$/apps/site/data/kit.json"]
    },
    "@agents/drive#site-shots": {
      "command": ["nix", "run", ".#media", "--", "node", "site.ts"],
      "dependsOn": ["//#dist", "@agents/drive#tui-test", "//#media-env"],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "CAST_FFMPEG",
        "CAST_MESA",
        "SITE_JOBS",
        "E2E_JOBS",
        "E2E_JOBS_CLAUDE",
        "E2E_JOBS_PI",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_TMP",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ],
      "inputs": [
        "**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/lib/kits/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/__pycache__/**",
        "!**/.venv/**",
        "!**/.*_cache/**",
        "!**/.claude-plugin/types/**",
        "!**/dist/**",
        "!**/*.actual.*",
        "!**/.out/**",
        "!**/*.spec.ts",
        "!**/__snapshots__/**",
        "!**/turbo.json",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.claude-plugin/types/**",
        "!$TURBO_ROOT$/**/*.actual.*",
        "!$TURBO_ROOT$/**/turbo.json",
        "!$TURBO_ROOT$/**/*.spec.ts",
        "!$TURBO_ROOT$/**/*.test.ts",
        "!$TURBO_ROOT$/**/*.test.tsx",
        "!site-vscode.ts",
        "!vscode.ts",
        "!lib/vscode.ts",
        "!lib/vscode-scenario.ts",
        "!*/vscode.scenarios.ts",
        "!README.md"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/site/media/**",
        "!$TURBO_ROOT$/apps/site/media/kit/**",
        "!$TURBO_ROOT$/apps/site/media/*/vscode-*",
        "!$TURBO_ROOT$/apps/site/media/*/media-vscode.json"
      ]
    },
    "@agents/drive#site-vscode": {
      "command": [
        "nix",
        "run",
        ".#media",
        "--",
        "sh",
        "-c",
        "if [ \"$(uname -s)\" = Linux ]; then exec node site-vscode.ts \"$@\"; fi; echo \"site-vscode: needs a Linux compositor, skipped\"",
        "site-vscode"
      ],
      "dependsOn": ["//#dist", "//#media-env"],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME",
        "XDG_CACHE_HOME",
        "XDG_RUNTIME_DIR",
        "TUI_TEST_BIN",
        "DISPLAY",
        "WAYLAND_DISPLAY",
        "FONTCONFIG_FILE",
        "CAST_FFMPEG",
        "CAST_MESA",
        "SITE_JOBS",
        "E2E_JOBS",
        "E2E_JOBS_CLAUDE",
        "E2E_JOBS_PI",
        "E2E_KEEP",
        "E2E_TIMING",
        "E2E_TMP",
        "E2E_VSCODE_CODE",
        "E2E_VSCODE_EXTENSIONS",
        "E2E_VSCODE_CAGE",
        "E2E_VSCODE_FONTCONFIG_FILE"
      ],
      "inputs": [
        "**",
        "$TURBO_ROOT$/apps/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/__pycache__/**",
        "!**/.venv/**",
        "!**/.*_cache/**",
        "!**/.claude-plugin/types/**",
        "!**/dist/**",
        "!**/*.actual.*",
        "!**/.out/**",
        "!**/*.spec.ts",
        "!**/__snapshots__/**",
        "!**/turbo.json",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.claude-plugin/types/**",
        "!$TURBO_ROOT$/**/*.actual.*",
        "!$TURBO_ROOT$/**/turbo.json",
        "!$TURBO_ROOT$/**/*.spec.ts",
        "!$TURBO_ROOT$/**/*.test.ts",
        "!$TURBO_ROOT$/**/*.test.tsx",
        "!*/claude.scenarios.ts",
        "!*/pi.scenarios.ts",
        "!README.md"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/site/media/*/vscode-*",
        "$TURBO_ROOT$/apps/site/media/*/media-vscode.json"
      ]
    },
    "//#kit-new": {
      "command": ["node", "lib/kits/new.ts"],
      "cache": false
    },
    "check": {
      "dependsOn": ["check-types", "test", "test:claude", "e2e"]
    },
    "//#check": {
      "dependsOn": ["//#fmt:check", "//#lint", "//#lint:sh", "agents-python#check"]
    },
    "agents-python#check-types": {
      "command": null
    },
    "run-handoff#check-types": {
      "command": null
    },
    "agents-python#check": {
      "command": null,
      "dependsOn": ["agents-python#lint:py", "agents-python#fmt:check", "run-handoff#test"]
    },
    "agents-python#lint:py": {
      "command": ["uv", "run", "--frozen", "ruff", "check"],
      "inputs": [
        "**/*.py",
        "pyproject.toml",
        "skills/*/scripts/pyproject.toml",
        "uv.lock",
        ".python-version"
      ]
    },
    "agents-python#fmt:check": {
      "command": ["uv", "run", "--frozen", "ruff", "format", "--check"],
      "inputs": [
        "**/*.py",
        "pyproject.toml",
        "skills/*/scripts/pyproject.toml",
        "uv.lock",
        ".python-version"
      ]
    },
    "agents-python#fmt": {
      "command": ["uv", "run", "--frozen", "ruff", "format"],
      "cache": false
    },
    "//#lint:sh": {
      "command": [
        "sh",
        "-c",
        "git ls-files -z \"*.sh\" | xargs -0 ./lib/tools/lint/node_modules/.bin/shellcheck -S warning"
      ],
      "inputs": ["**/*.sh", "lib/tools/lint/package.json"]
    },
    // Not part of `check`: the one task that needs nix. It reads the flake's nix files and lock; the
    // treefmt check it runs formats nix files only, so nothing else in the tree reaches its result.
    // CI runs it when this key misses (see .github/workflows/ci.yml).
    "//#check:nix": {
      "command": ["nix", "flake", "check", "--print-build-logs"],
      "inputs": [
        "**/*.nix",
        "flake.lock",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/.venv/**",
        "!apps/site/dist/**"
      ],
      "passThroughEnv": [
        "NIX_*",
        "SSL_CERT_FILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME"
      ]
    }
  }
}
