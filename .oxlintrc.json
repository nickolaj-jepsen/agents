{
  "plugins": ["unicorn", "typescript", "oxc", "react"],
  "rules": {
    "no-control-regex": "off",
    "react/jsx-key": "off"
  },
  "ignorePatterns": [
    ".agents/**",
    "skills/mermaid/scripts/vendor/**",
    "skills/agent-plugin-dev/references/upstream/**",
    "plugins/*/claude/ui.tsx",
    "plugins/*/claude/checks.tsx",
    "plugins/*/claude/types.d.ts",
    "kit/catalog/claude/claude/ui.tsx",
    "kit/catalog/claude/claude/samples.ts",
    "site/dist/**",
    "site/.astro/**"
  ],
  "overrides": [
    {
      "files": ["plugins/*/pi/**", "plugins/*/claude/**", "plugins/*/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@earendil-works/pi-tui",
                "importNames": [
                  "truncateToWidth",
                  "visibleWidth",
                  "wrapTextWithAnsi",
                  "sliceByColumn",
                  "Markdown",
                  "Text",
                  "Box",
                  "Container",
                  "VStack",
                  "HStack",
                  "Spacer",
                  "SelectList"
                ],
                "message": "Don't draw with pi-tui helpers. Measure and wrap with kit/lines.ts, paint with kit/paint/pi.ts."
              },
              {
                "name": "@earendil-works/pi-ai",
                "importNames": ["Type"],
                "message": "Import Type from typebox, not from pi-ai. See docs/development.md#change-or-add-a-plugin."
              }
            ],
            "patterns": [
              {
                "group": ["**/kit/legacy/**", "./ui"],
                "message": "This is the legacy kit. Use the kit's components (kit/<component>/, listed in AGENTS.md) instead."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "theme",
            "property": "fg",
            "message": "Don't style with theme directly. Build styled lines from kit components and paint them with kit/paint/pi.ts."
          },
          {
            "object": "theme",
            "property": "bg",
            "message": "Don't style with theme directly. Build styled lines from kit components and paint them with kit/paint/pi.ts."
          },
          {
            "object": "theme",
            "property": "bold",
            "message": "Don't style with theme directly. Build styled lines from kit components and paint them with kit/paint/pi.ts."
          },
          {
            "object": "theme",
            "property": "italic",
            "message": "Don't style with theme directly. Build styled lines from kit components and paint them with kit/paint/pi.ts."
          },
          {
            "object": "theme",
            "property": "underline",
            "message": "Don't style with theme directly. Build styled lines from kit components and paint them with kit/paint/pi.ts."
          },
          {
            "object": "theme",
            "property": "strikethrough",
            "message": "Don't style with theme directly. Build styled lines from kit components and paint them with kit/paint/pi.ts."
          }
        ],
        "react/forbid-elements": [
          "error",
          {
            "forbid": [
              {
                "element": "Box",
                "message": "Don't use raw elements. Compose kit components; kit/paint/claude.tsx paints them."
              },
              {
                "element": "Text",
                "message": "Don't use raw elements. Compose kit components; kit/paint/claude.tsx paints them."
              },
              {
                "element": "Button",
                "message": "Don't use raw elements. Compose kit components; kit/paint/claude.tsx paints them."
              },
              {
                "element": "Markdown",
                "message": "Don't use raw elements. Compose kit components; kit/paint/claude.tsx paints them."
              },
              {
                "element": "Link",
                "message": "Don't use raw elements. Compose kit components; kit/paint/claude.tsx paints them."
              },
              {
                "element": "Image",
                "message": "Don't use raw elements. Compose kit components; kit/paint/claude.tsx paints them."
              },
              {
                "element": "Svg",
                "message": "Don't use raw elements. Compose kit components; kit/paint/claude.tsx paints them."
              }
            ]
          }
        ]
      }
    },
    // An override replaces a rule's options whole, so each restates what it keeps of the shared ones.
    // A core is harness-free (docs/development.md#change-or-add-a-plugin): it imports its own
    // files and the mod's copy of the kit, which also keeps it clear of pi-tui and the legacy kit.
    {
      "files": ["plugins/*/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                // One gitignore-style list, last match wins: oxlint doesn't combine several groups.
                // A core folder is at most one level deep, so `core/` and `core/<dir>/` are spelled out.
                "group": [
                  "*",
                  "!./**",
                  "!../**",
                  "../pi/**",
                  "../../pi/**",
                  "../claude/**",
                  "../../*/**",
                  "../../../**",
                  "!../claude/kit/**",
                  "!../../claude/kit/**"
                ],
                "message": "A core has no Node builtin and no package, and imports only its own files and the mod's copy of the kit, claude/kit/. See docs/development.md#change-or-add-a-plugin."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          { "name": "process", "message": "No Node or DOM APIs in a core." },
          { "name": "Buffer", "message": "No Node or DOM APIs in a core." },
          { "name": "window", "message": "No Node or DOM APIs in a core." },
          { "name": "document", "message": "No Node or DOM APIs in a core." },
          { "name": "localStorage", "message": "No Node or DOM APIs in a core." }
        ]
      }
    },
    // A core's specs run under vitest in Node and load nowhere else: they may read fixtures and use packages.
    {
      "files": ["plugins/*/core/**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    },
    // A mod can't import outside its plugin folder: the install copies the plugin alone.
    {
      "files": ["plugins/*/claude/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@earendil-works/pi-tui",
                "message": "A mod runs in Claude Code, which has no pi-tui. Measure and wrap with kit/lines.ts, paint with kit/paint/claude.tsx."
              }
            ],
            "patterns": [
              {
                "group": ["**/kit/legacy/**", "./ui"],
                "message": "This is the legacy kit. Use the kit's components (kit/<component>/, listed in AGENTS.md) instead."
              },
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "A mod can't import outside its plugin. Import ./kit/ (kit/sync.ts copies the kit there) or ../core/. See docs/development.md#change-or-add-a-plugin."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/claude/kit/**"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off",
        "react/forbid-elements": "off"
      }
    },
    // The site reads its content as data (site/data/), so its pages reach into scripts/ and kit/ for
    // types only, and site/ alone builds. Covers the frontmatter of .astro pages too.
    {
      "files": ["site/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(scripts|kit)/",
                "allowTypeImports": true,
                "message": "site/src imports a value from outside site/; only `import type` may. See docs/development.md#preview-the-published-site."
              }
            ]
          }
        ]
      }
    },
    // Legacy files: they still draw around the kit. List only shrinks; never add a file here.
    {
      "files": [
        "plugins/answer/claude/answer.test.tsx",
        "plugins/answer/claude/register.tsx",
        "plugins/answer/claude/transcript.tsx",
        "plugins/answer/pi/offer.ts",
        "plugins/answer/pi/transcript.ts",
        "plugins/docfix/claude/evidence.tsx",
        "plugins/docfix/claude/register.tsx",
        "plugins/git-menu/claude/register.tsx",
        "plugins/image-preview/claude/image-preview.test.tsx",
        "plugins/image-preview/claude/register.tsx",
        "plugins/linear-issue/claude/gui.tsx",
        "plugins/linear-issue/claude/linear-issue.test.tsx",
        "plugins/linear-issue/claude/register.tsx",
        "plugins/spellfix/claude/band.tsx",
        "plugins/spellfix/claude/register.tsx",
        "plugins/spellfix/claude/spellfix.test.tsx",
        "plugins/spellfix/pi/index.ts",
        "plugins/transcript-tweaks/pi/condense.ts"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off",
        "react/forbid-elements": "off"
      }
    }
  ]
}
