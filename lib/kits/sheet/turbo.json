{
  "extends": ["//"],
  "tasks": {
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"]
    },
    "e2e": {
      "command": ["node", "../../tools/drive/drive.ts", "test", "kit-sheet"],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    },
    "e2e:update": {
      "command": ["node", "../../tools/drive/drive.ts", "test", "kit-sheet", "--update"],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    },
    "media": {
      "command": [
        "nix",
        "run",
        "../../..#media",
        "--",
        "node",
        "../../tools/drive/drive.ts",
        "record",
        "kit-sheet"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/site/media/kit/sheet/**",
        "!$TURBO_ROOT$/apps/site/media/kit/sheet/vscode-*",
        "!$TURBO_ROOT$/apps/site/media/kit/sheet/media-vscode.json"
      ],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    },
    "media:vscode": {
      "command": [
        "nix",
        "run",
        "../../..#media",
        "--",
        "node",
        "../../tools/drive/drive.ts",
        "record",
        "kit-sheet",
        "--harness",
        "vscode"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/site/media/kit/sheet/vscode-*",
        "$TURBO_ROOT$/apps/site/media/kit/sheet/media-vscode.json"
      ],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    }
  }
}
