{
  "extends": ["//"],
  "tasks": {
    "e2e": {
      "command": ["node", "../../tools/drive/drive.ts", "test", "kit-frame"],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    },
    "e2e:update": {
      "command": ["node", "../../tools/drive/drive.ts", "test", "kit-frame", "--update"],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    },
    "media": {
      "command": [
        "nix",
        "run",
        "../../..#media",
        "--",
        "node",
        "../../tools/drive/drive.ts",
        "record",
        "kit-frame"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/site/media/kit/frame/**",
        "!$TURBO_ROOT$/apps/site/media/kit/frame/vscode-*",
        "!$TURBO_ROOT$/apps/site/media/kit/frame/media-vscode.json"
      ],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    },
    "media:vscode": {
      "command": [
        "nix",
        "run",
        "../../..#media",
        "--",
        "node",
        "../../tools/drive/drive.ts",
        "record",
        "kit-frame",
        "--harness",
        "vscode"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/site/media/kit/frame/vscode-*",
        "$TURBO_ROOT$/apps/site/media/kit/frame/media-vscode.json"
      ],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    }
  }
}
