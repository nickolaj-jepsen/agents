{
  "extends": [
    "//"
  ],
  "tasks": {
    "test": {
      "command": [
        "./node_modules/.bin/vitest",
        "run"
      ]
    },
    "e2e": {
      "command": [
        "node",
        "../../tools/drive/run.ts"
      ],
      "dependsOn": [
        "^topo",
        "@agents/kit-catalog#build"
      ]
    },
    "e2e:update": {
      "command": [
        "node",
        "../../tools/drive/run.ts",
        "-u"
      ],
      "dependsOn": [
        "@agents/kit-catalog#build"
      ]
    }
  }
}
