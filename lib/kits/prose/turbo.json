{
  "extends": ["//"],
  "tasks": {
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"]
    },
    "e2e": {
      "command": ["node", "../../tools/drive/drive.ts", "test", "kit-prose"],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    },
    "e2e:update": {
      "command": ["node", "../../tools/drive/drive.ts", "test", "kit-prose", "--update"],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    },
    "media": {
      "command": [
        "nix",
        "run",
        "../../..#media",
        "--",
        "node",
        "../../tools/drive/drive.ts",
        "record",
        "kit-prose"
      ],
      "outputs": ["$TURBO_ROOT$/apps/site/media/kit/prose/**"],
      "dependsOn": ["$TURBO_EXTENDS$", "@agents/kit-catalog#build"]
    }
  }
}
