{
  "extends": ["//"],
  "tasks": {
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"]
    },
    "e2e": {
      "command": ["node", "../../tools/drive/drive.ts", "test", "kit-band"],
      "dependsOn": ["^topo", "@agents/kit-catalog#build"]
    },
    "e2e:update": {
      "command": ["node", "../../tools/drive/drive.ts", "test", "kit-band", "--update"],
      "dependsOn": ["@agents/kit-catalog#build"]
    }
  }
}
