{
  "extends": ["//"],
  "tasks": {
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/.claude-plugin/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/README.md",
        "$TURBO_ROOT$/skills/**",
        "!$TURBO_ROOT$/**/node_modules/**"
      ]
    }
  }
}
