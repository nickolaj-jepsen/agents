{
  "extends": ["//"],
  "tasks": {
    // What the apps and kits import of this package is the bundler. `content.ts` and `readme.ts`
    // are the site's and the README's (the site lists content.ts as an input of its own).
    "topo": { "inputs": ["build.ts", "package.json"] },
    "test": {
      "command": ["./node_modules/.bin/vitest", "run"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/.claude-plugin/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/README.md",
        "$TURBO_ROOT$/skills/**",
        // Read by the spec that an unreleased skill stays out of the model.
        "$TURBO_ROOT$/unreleased/**",
        "!$TURBO_ROOT$/**/node_modules/**"
      ]
    }
  }
}
