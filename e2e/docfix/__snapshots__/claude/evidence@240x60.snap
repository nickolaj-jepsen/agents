│     path     pkgs/agent-hub/package.nix
│     command  TMPDIR=<tmp>   PYTHONPATH=. uv run --quiet --with
│              markdown-it-py python -m unittest discover -s tests -p
│              'test_*.py'
│     quote    “if it happens again, just wait a bit and try again”
