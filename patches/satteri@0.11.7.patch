@@ -11,10 +11,21 @@ const { readFileSync } = require('fs')
 let nativeBinding = null
 const loadErrors = []
 
+const isGlibcFromReport = () => {
+  if (!process.report || typeof process.report.getReport !== 'function') return false
+  process.report.excludeNetwork = true
+  const report = process.report.getReport()
+  return Boolean(report.header && report.header.glibcVersionRuntime)
+}
+
+// The libc this process is linked against decides, and the report is the only source that
+// describes the process: `/usr/bin/ldd` describes the system's rootfs. A glibc Node on a musl
+// system, which is Nix's Node in an Alpine guest, would otherwise load the musl build that
+// pnpm (which asks the report first) never installed.
 const isMusl = () => {
   let musl = false
   if (process.platform === 'linux') {
-    musl = isMuslFromFilesystem()
+    musl = isGlibcFromReport() ? false : isMuslFromFilesystem()
     if (musl === null) {
       musl = isMuslFromReport()
     }
