{
  "name": "agents",
  "version": "0.0.0",
  "private": true,
  "repository": "github:nickolaj-jepsen/agents",
  "type": "module",
  "scripts": {
    "drive": "node lib/tools/drive/drive.ts",
    "gate": "turbo run check --concurrency=2",
    "gate:nix": "turbo run check:nix --concurrency=1",
    "gate:pages": "turbo run check:pages --concurrency=2",
    "gate:all": "pnpm gate && pnpm gate:nix && pnpm gate:pages",
    "hooks": "git config core.hooksPath .githooks",
    "release": "node lib/tools/build/release.ts",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.0"
}
